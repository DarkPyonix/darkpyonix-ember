{
  "scopeName": "source.host",
  "patterns": [
    { "match": "\\b(let|if)\\b", "name": "keyword.host" },
    { "match": "\\b[A-Za-z_]\\w*\\b", "name": "identifier.host" },
    { "begin": "\"", "end": "\"", "name": "string.quoted.host" },
    { "begin": "/\\*", "end": "\\*/", "name": "comment.block.host" },
    { "match": "//.*$", "name": "comment.line.host" }
  ],
  "injections": {
    "L:string.quoted.host": { "patterns": [ { "match": "\\$\\{[^}]*\\}", "name": "meta.interp.host" } ] },
    "comment.block - comment.line": { "patterns": [ { "match": "TODO|FIXME", "name": "keyword.todo.host" } ] },
    "R:source.host": { "patterns": [ { "match": "let", "name": "late.let.host" } ] },
    "string.quoted.host, comment.block.host": { "patterns": [ { "match": "@\\w+", "name": "entity.tag.host" } ] },
    "comment.line.host | string.quoted.host": { "patterns": [ { "match": "NOTE", "name": "bar.host" } ] },
    "L:(string.quoted.host | comment.block.host) -keyword.todo.host": { "patterns": [ { "match": "ERROR", "name": "invalid.host" } ] }
  }
}
